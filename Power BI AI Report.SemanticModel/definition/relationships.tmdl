relationship FactSales_OrderDate_DimDate
	fromColumn: FactSales.OrderDate
	toColumn: DimDate.Date

relationship FactSales_ShipDate_DimDate
	isActive: false
	fromColumn: FactSales.ShipDate
	toColumn: DimDate.Date

relationship FactSales_Product_DimProduct
	fromColumn: FactSales.ProductKey
	toColumn: DimProduct.ProductKey

relationship FactSales_Customer_DimCustomer
	fromColumn: FactSales.CustomerKey
	toColumn: DimCustomer.CustomerKey

relationship FactSales_Region_DimRegion
	fromColumn: FactSales.RegionKey
	toColumn: DimRegion.RegionKey

